PandoraAmalgam: {
	DisplayName: Амальгуль
	Tooltip:
		'''
		Даёт эффекты всех аксессуаров Ящика Пандоры
		При восстановлении маны создаёт сгустки эктоплазмы, чей урон зависит от количества восстановленной маны
		Нажмите клавишу способности аксессуара, чтобы выпустить звуковую волну, наносящую урон вам и врагам
		Каждые несколько секунд появляются руки, которые наводятся на вас и исцеляют при соприкосновении
		Периодически выпускает наручник в ближайшего врага; прикреплённые наручником враги получают на 25% больше урона
		'''
}

PandoraChalice: {
	DisplayName: Нечестивый Грааль
