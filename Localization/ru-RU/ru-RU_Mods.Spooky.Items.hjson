Bonemeal: {
	DisplayName: Костная мука
	Tooltip: Все находящиеся поблизости цветения растут заметно быстрее
}

DaylightSavings: {
	DisplayName: Лишние минутки
	Tooltip: При окончании действия ваших баффов цветения есть 20% шанс продлить их ещё на 2 минуты
}

FarmerGlove: {
	DisplayName: Перчатка фермера
	Tooltip: Увеличивает скорость атаки на 10% за каждый имеющийся бафф цветения
}

HerbShaker: {
	DisplayName: Травы и специи
	Tooltip: Съев цветение, которого у вас нет, вы получите случайный бафф на 1 минуту
}

TheMask: {
	DisplayName: Странная маска
	Tooltip: Даёт 5 защиты за каждый бафф цветения
}

Wormy: {
	DisplayName: Червяк Чарльз
	Tooltip:
		'''
		Призывает дружелюбного червя сражаться за вас
		Каждый ваш бафф цветения увеличивает его урон
		'''
}

CemeteryLily: {
	DisplayName: Лилия возрождения
	Tooltip:
		'''
		Уменьшает максимальное здоровье до одной трети и даёт 2 возрождения
		При смерти расходуется одно возрождение, а ваши характеристики увеличиваются на 15 сек.
		Длительность: 3 мин.
		'''
}

CemeteryMarigold: {
	DisplayName: Путеводные бархатцы
	Tooltip:
		'''
		Периодически высаживает наносящие урон бархатцы во время передвижения
		Чем быстрее вы движетесь, тем выше урон от бархатцев
		Длительность: 5 мин.
		'''
}

CemeteryPoppy: {
	DisplayName: Декоративный мак
	Tooltip:
		'''
		После смерти врага появляется мак, который некоторое время стреляет по другим ближайшим врагам
		Одновременно может быть не более 3 маков
		Длительность: 5 мин.
		'''
}

CemeteryRose: {
	DisplayName: Увядшая роза
	Tooltip:
		'''
		Вы получаете на 10% больше урона
		При получении урона вы выпускаете мощные увядшие лепестки
		Чем больше урона вы получаете, тем сильнее становятся увядшие лепестки
		Длительность: 3 мин.
		'''
}

DandelionHerd: {
	DisplayName: Стадо одуванчиков
	Tooltip:
		'''
		Во время полёта оставляет за собой скопления семян одуванчика, которые слегка наводятся на врагов
		Чем выше ваше максимальное время полёта, тем больше урон от скоплений семян
		Длительность: 2 мин.
		'''
}

DandelionMapleSeed: {
	DisplayName: Кленовый вихрь
	Tooltip:
		'''
		Во время полёта вокруг вас периодически появляются планирующие кленовые семечки
		Подбор этих семечек немного увеличивает время полёта
		Длительность: 4 мин.
		'''
}

DandelionTumbleweed: {
	DisplayName: Перекати-трава
	Tooltip:
		'''
		Попадания по врагам во время полёта могут вызвать появление наносящих урон перекати-полей
		Длительность: 5 мин.
		'''
}

Dragonfruit: {
	DisplayName: Дива-драконий фрукт
	Tooltip:
		'''
		Создаёт драконий фрукт, который кружит вокруг вас и преследует ближайших врагов
		После попадания по врагу фрукт погибает и через несколько секунд возрождается
		Поедание нескольких таких цветений во время действия эффекта увеличивает количество его стаков
		Каждый стак этого баффа добавляет ещё один фрукт, вращающийся вокруг вас, — всего до 10
		Длительность: 3 мин.
		'''
}

FallGourd: {
	DisplayName: Кабачок-давичок
	Tooltip:
		'''
		Во время падения увеличивает урон на 15%
		Длительность: 5 мин.
		'''
}

FallSoulPumpkin: {
	DisplayName: Тыквопризрак
	Tooltip:
		'''
		Периодически создаёт самонаводящуюся призрачную тыкву, пока вы держите оружие
		Урон тыкв зависит от оружия, которое вы держите
		Призрачные тыквы ненадолго поджигают врагов
		Длительность: 4 мин.
		'''
}

FallWaterGourd: {
	DisplayName: Горлянка-поливалка
	Tooltip:
		'''
		Полностью выросшие культуры цветения могут принести дополнительные цветения и семя
		Длительность: 10 мин.
		'''
}

FallZucchini: {
	DisplayName: Шандарах-цукини
	Tooltip:
		'''
		Периодически поражает ближайших врагов электрическими разрядами на несколько секунд
		Урон электричества зависит от урона врага
		Длительность: 2 мин.
		'''
}

FossilBlackPepper: {
	DisplayName: Камешки чёрного перца
	Tooltip:
		'''
		Периодически создаёт перечные камушки, увеличивающие защиту при подборе
		Чем ниже ваша защита, тем чаще появляются перечные камушки
		Каждый камушек даёт 2 защиты, максимум до 20
		Этот бонус защиты действует до окончания эффекта данного цветения
		Длительность: 5 мин.
		'''
}

FossilDutchmanPipe: {
	DisplayName: Кирказон
	Tooltip:
		'''
		Создаёт вокруг вас большую ауру кирказона
		Попадание снарядом по врагу в ауре наносит урон всем врагам, находящимся внутри неё
		Длительность: 5 мин.
		'''
}

FossilMagnolia: {
	DisplayName: Стойкая магнолия
	Tooltip:
		'''
		Снижает получаемый урон при неполном здоровье
		Чем меньше здоровья, тем сильнее снижение урона
		Длительность: 3 мин.
		'''
}

FossilProtea: {
	DisplayName: Алмазная протея
	Tooltip:
		'''
		Создаёт тяжёлый щит из протеи, увеличивающий вашу защиту
		Этот щит также значительно ускоряет ваше падение
		При падении с достаточной высоты вверх вылетают наносящие урон алмазы
		Длительность: 2 мин.
		'''
}

FungusBluePinkgill: {
	DisplayName: Спектральный синежаберник
	Tooltip:
		'''
		Попадания по врагам могут накладывать на них эффект спектральных спор
		Этот дебафф заставляет врагов каждую секунду порождать самонаводящиеся магические споры
		Длительность: 3 мин.
		'''
}

FungusDevilTooth: {
	DisplayName: Грибок кровоточащих дёсен
	Tooltip:
		'''
		Попадания по врагам могут заразить их грибковым гингивитом
		Этот дебафф заставляет убитых врагов порождать кровавые комки зубов
		При касании эти комки взрываются и выпускают зубы
		Длительность: 3 мин.
		'''
}

FungusInkCap: {
	DisplayName: Чернильная поганка
	Tooltip:
		'''
		Попадания по врагам могут заразить их чернильными спорами
		При получении урона враги под этим дебаффом порождают остающиеся чернильные споры
		Длительность: 3 мин.
		'''
}

FungusRedCage: {
	DisplayName: Красный грибок-клетка
	Tooltip:
		'''
		При попадании по врагу на нём может вырасти грибок-клетка, который замедляет его
		Длительность: 3 мин.
		'''
}

SeaBarnacle: {
	DisplayName: Гигантский балянус
	Tooltip:
		'''
		Попадания снарядами по врагам иногда заражают их наносящими урон балянусами
		При нанесении урона балянусы имеют шанс создать ещё одного балянуса
		Во время дождя балянусы растут на врагах быстрее
		Длительность: 3 мин.
		'''
}

SeaCucumber: {
	DisplayName: Прожорливый огурец
	Tooltip:
		'''
		Выпускает желудок, который прикрепляется к ближайшему врагу
		Желудок остаётся прикреплённым, пока вы находитесь достаточно близко к врагу
		Пока он прикреплён, желудок постепенно наносит врагу урон и периодически исцеляет вас
		Во время дождя постепенный урон и исцеление усиливаются
		Длительность: 5 мин.
		'''
}

SeaSponge: {
	DisplayName: Чистящая морская губка
	Tooltip:
		'''
		Даёт небольшой шанс поглотить любой вражеский снаряд, приблизившийся к вам
		Поглощение снаряда снижает получаемый урон на 10 секунд
		Во время дождя шанс поглощения снарядов увеличивается
		Длительность: 3 мин.
		'''
}

SeaUrchin: {
	DisplayName: Ай-ёж
	Tooltip:
		'''
		На вашей голове вырастает колючий ядовитый морской ёж
		Когда вы получаете урон, морской ёж контратакует, выпуская ядовитые иглы
		Во время дождя ядовитые иглы ежа становятся сильнее
		Длительность: 4 мин.
		'''
}

SpringHeartFlower: {
	DisplayName: Дицентра
	Tooltip:
		'''
		Увеличивает регенерацию здоровья за каждый занятый слот с баффом цветения
		Длительность: 5 мин.
		'''
}

SpringIris: {
	DisplayName: Расширенный ирис-глаз
	Tooltip:
		'''
		Каждую минуту в месте курсора появляются лепесток ириса и большой глаз
		Лепесток ириса медленно преследует глаз, постепенно ускоряясь и нанося урон всему, чего касается
		При столкновении лепесток и глаз погибают
		Длительность: 5 мин.
		'''
}

SpringOrchid: {
	DisplayName: Обезьянья орхидея
	Tooltip:
		'''
		При использовании оружие может выпустить веер сюрикенов обезьяньей орхидеи
		Урон сюрикенов зависит от урона используемого оружия
		Длительность: 4 мин.
		'''
}

SpringRose: {
	DisplayName: Усеянная шипами роза
	Tooltip:
		'''
		Создаёт вокруг вас кольцо шипов, наносящее небольшой урон врагам
		Кольцо шипов иногда вызывает у врагов кратковременное кровотечение
		Длительность: 6 мин.
		'''
}

SummerLemon: {
	DisplayName: Мультилимон
	Tooltip:
		'''
		При использовании оружия иногда выпускаются отскакивающие лимонные бомбы
		Каждый лимон в серии вызывает появление ещё одного отскакивающего лимона
		Длительность: 5 мин.
		'''
}

SummerOrange: {
	DisplayName: Злой апельсин
	Tooltip:
		'''
		Даёт злой апельсин, который кружит вокруг вас, наносит урон врагам и поджигает их
		Чем быстрее вы движетесь, тем выше его скорость, дальность и урон
		Длительность: 5 мин.
		'''
}

SummerPineapple: {
	DisplayName: Покерный ананас
	Tooltip:
		'''
		Увеличивает урон критических ударов на 35%, но вдвое снижает общий шанс критического удара
		Критический удар также немного восстанавливает здоровье
		Длительность: 5 мин.
		'''
}

SummerSunflower: {
	DisplayName: Надсолнух
	Tooltip:
		'''
		Значительно увеличивает скорость роста всех культур цветения
		Даёт бафф «Счастливый подсолнух» на 2 минуты
		Длительность: 5 минут.
		'''
}

UltimateTomato: {
	DisplayName: Томатопчик
	Tooltip:
		'''
		Держа оружие, нажмите клавишу способности аксессуара, чтобы разбросать вокруг себя кучу помидоров
		Урон этих помидоров зависит от оружия, которое вы держите
		Каждое использование этой способности отнимает 20 секунд от длительности этого цветения
		Длительность: 5 мин.
		'''
}

VegetableCauliflower: {
	DisplayName: Трио цветной капусты
	Tooltip:
		'''
		Увеличивает урон призывателя на 10%
		Попадания хлыстом по врагам могут призывать самонаводящуюся цветную капусту
		Длительность: 5 мин.
		'''
}

VegetableEggplantPaint: {
	DisplayName: Баклажан-граффитчик
	Tooltip:
		'''
		Увеличивает стрелковый урон на 10%
		Стрелковые снаряды оставляют за собой брызги краски, наносящие урон
		Длительность: 5 мин.
		'''
}

VegetablePepper: {
	DisplayName: Калифорнийский перец
	Tooltip:
		'''
		Увеличивает урон ближнего боя на 10%
		Попадания оружием ближнего боя накладывают на врагов эффект остроты перца
		Враги под действием этой остроты извергают огонь в ближайших врагов
		Длительность: 5 мин.
		'''
}

VegetableRomanesco: {
	DisplayName: Ядовитый романеско
	Tooltip:
		'''
		Увеличивает магический урон на 10%
		При использовании магического оружия иногда появляется романеско, который некоторое время остаётся на месте
		Попадание по нему магическим снарядом заставляет его взорваться, выпустив самонаводящиеся ядовитые листья
		Длительность: 5 мин.
		'''
}

WinterBlackberry: {
	DisplayName: Ежевичный ледник
	Tooltip:
		'''
		Любые съеденные вами цветения будут действовать вдвое дольше обычного
		Длительность: 2 мин.
		'''
}

WinterBlueberry: {
	DisplayName: Черничная грусть
	Tooltip:
		'''
		Попадания по врагам могут накладывать на них эффект замороженного черничного сока, замедляющий их
		Любые враги рядом с первоначально поражённым врагом также получат этот эффект, но на более короткое время
		Длительность: 4 мин.
		'''
}

WinterGooseberry: {
	DisplayName: Наливной крыжовник
	Tooltip:
		'''
		Каждый третий случай нанесения вами урона с шансом 33% выпускает вверх крыжовник
		Подобранный крыжовник на короткое время увеличивает регенерацию здоровья и ускорение передвижения на 15%
		Крыжовник уничтожается при столкновении с врагами или вражескими снарядами
		Длительность: 5 мин.
		'''
}

WinterStrawberry: {
	DisplayName: Горная клубника
	Tooltip:
		'''
		Каждые 40 секунд появляются несколько ягод горной клубники, которые можно подобрать
		Подобранные ягоды на 10 секунд увеличивают урон, шанс критического удара и отбрасывание на 10%
		Длительность: 5 мин.
		'''
}

DaffodilHairpin: {
	DisplayName: Цветочная заколка
	Tooltip:
		'''
		Постоянно создаёт до 6 цветочных лепестков, вращающихся вокруг вас
		При получении урона все имеющиеся лепестки наводятся на ближайших врагов
		Лепестки наносят урон, равный полученному вами урону, но не менее 40
		'''
}

FlowerPotShoe: {
	DisplayName: Левый ботинок Костяры
	Tooltip:
		'''
		Увеличивает максимальную скорость передвижения и ускорение
		Во время полёта или бега выпускает самонаводящиеся цветы
		Чем выше ваша текущая скорость, тем чаще выпускаются цветы и тем больше их урон
		«Не мог же он просто взять и уйти»
		'''
}

FlyCharm: {
	DisplayName: Амулет мух
	Tooltip:
		'''
		Постепенно призывает вокруг вас рой мух, максимум до 10
		Каждая активная муха даёт 1 доп. ед. защиты
		При получении урона все мухи погибают и возрождаются через 30 секунд
		'''
}

HunterScarf: {
	DisplayName: Шарф Старого охотника
	Tooltip:
		'''
		Ближайшие к вам враги будут помечены.
		Помеченные враги получают на 25% больше урона от ваших атак
		'''
}

MocoNose: {
	DisplayName: Сопливый шнобель
	Tooltip:
		'''
		Даёт вам полоску соплей, которая заполняется при подборе комков соплей
		При нанесении урона врагам иногда выпадают комки соплей
		Когда полоска заполнится, использование любого оружия выпускает огромный веер соплей
		Урон и скорость соплей зависят от оружия, использованного при их выпуске
		'''
}

MocoNoseBooger: {
	DisplayName: Сопля
	Tooltip: ""
}

OrroboroEmbryo: {
	DisplayName: Неумирающий эмбрион
	Tooltip:
		'''
		После смерти вы возрождаетесь и на короткое время значительно увеличиваете свою регенерацию и защиту
		Перезарядка способности возрождения: 5 мин.
		Во время перезарядки урон и шанс критического удара увеличиваются на 8%
		'''
}

PumpkinSpiceLatte: {
	DisplayName: Тыквенно-пряный латте
	Tooltip: Можно использовать бесконечно
}

SpiritAmulet: {
	DisplayName: Амулет духа
	Tooltip:
		'''
		При вашей атаке врагов иногда призывает дружественных кладбищенских призраков
		Урон призраков зависит от нанесённого вами урона
		'''
}

BossBagBigBone: {
	DisplayName: Мешок с сокровищами (Костяра)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagDaffodil: {
	DisplayName: Мешок с сокровищами (Нарцисс)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagMoco: {
	DisplayName: Мешок с сокровищами (Шмыг)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagOldHunter: {
	DisplayName: Мешок с сокровищами (Старый охотник)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagOrroboro: {
	DisplayName: Мешок с сокровищами (Орро и Боро)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagRotGourd: {
	DisplayName: Мешок с сокровищами (Гнилой тыквардеец)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagSpookFishron: {
	DisplayName: Мешок с сокровищами (Жуткий Рыброн)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

BossBagSpookySpirit: {
	DisplayName: Мешок с сокровищами (Жуткий дух)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

CranberryJelly: {
	DisplayName: Клюквенный джем
	Tooltip:
		'''
		Автоматически используется, когда ваше здоровье падает ниже 50%
