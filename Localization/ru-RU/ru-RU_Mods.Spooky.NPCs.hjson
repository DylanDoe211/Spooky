RotGourd: {
	DisplayName: Гнилой тыквардеец

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/RottenSeed] в Жутком лесу. Оно выпадает при разрушении больших заплесневелых тыкв, растущих в этом биоме.
		DespawnMessage: Гнилая-лихая тыква раздавила всех игроков
	}
}

SpookySpirit: {
	DisplayName: Жуткий дух

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/EMFReader] вблизи Проклятой Статуи на Болотистом могильнике ночью.
		DespawnMessage: Манкий морок запугал до смерти всех игроков
	}
}

Moco: {
	DisplayName: Шмыг

	BossChecklistIntegration: {
		SpawnInfo: Нажмите ПКМ по Носвятилищу в Долине глаз, имея в инвентаре [i:Spooky/CottonSwab].
		DespawnMessage: Этой мелкой козявке начхать на вас
	}
}

DaffodilEye: {
	DisplayName: Нарцисс

	BossChecklistIntegration: {
		SpawnInfo: Бросьте в него [i:Spooky/Brick], чтобы разбудить.
		DespawnMessage: Нарцисс затмил всех игроков своим нарциссизмом
	}
}

OldHunterBoss: {
	DisplayName: Старый охотник

	BossChecklistIntegration: {
		SpawnInfo: Оживите его труп, поднеся к нему [i:Spooky/OldHunterSoul].
		DespawnMessage: Старый охотник закончил свою охоту
	}
}

OrroHead: {
	DisplayName: Орро

	BossChecklistIntegration: {
		EntryName: Орро и Боро
		SpawnInfo: Вылейте [i:Spooky/Concoction] на гигантское яйцо в Долине глаз после завершения события «Яичное вторжение».
		DespawnMessage: Орро и Боро поделили туши всех игроков пополам
	}
}

BigBone: {
	DisplayName: Костяра

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/Fertilizer], стоя рядом с гигантским цветочным горшком в катакомбах.
		DespawnMessage: Все игроки окостенели от страха пред Костярой
	}
}

SpookFishron: {
	DisplayName: Жуткий Рыброн

	BossChecklistIntegration: {
		SpawnInfo: Рыбачьте в океане ночью во время Тыквенной луны, используя [i:Spooky/SinisterSnailItem] в качестве наживки. Зловещие улитки появляются в Жутком подземелье в хардмоде.
		DespawnMessage: Жуткий Рыброн довёл всех игроков до обморока своей оригинальностью
	}
}

